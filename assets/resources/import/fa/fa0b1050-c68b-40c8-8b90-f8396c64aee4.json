[1,0,0,[["cc.JsonAsset",["_name","json"],1]],[[0,0,1,3]],[[0,"FormulaConfig",{"1":{"id":1,"name":"Basis(s, b, grade)","formula":"(baseValue × (剑是某些家系?2:1) + effects.baseBonus + effects.seedBase) × gradeMultiplier^grade"},"2":{"id":2,"name":"Value(s, b)","formula":"(Basis + effects.flat) × effects.multiplier × effects.greatMultiplier × effects.valueScale"},"3":{"id":3,"name":"RefreshValue: baseBonus","formula":"80 × Rank(coal) + 160 × Rank(hearth)"},"4":{"id":4,"name":"RefreshValue: valueScale","formula":"1.10^Rank(thorn) × 1.10^Rank(token) × (grade≥8 且 blackstone ? 1.15 : 1) × (grade≥12 且 dragonseal ? 1.30 : 1)"},"5":{"id":5,"name":"Difficulty: Danger(grade)","formula":"breakCurve[grade] / (1 - breakCurve[grade]) × 21 / 9"},"6":{"id":6,"name":"ForgeReworkRules.Speed(run, fever)","formula":"min(1.65, 1 + 0.25×Rank(speed) + 0.1×Rank(loop)) × (fever ? 1.25 : 1)"},"7":{"id":7,"name":"Speed + bellows","formula":"min(2.5, Speed × (fever 且 bellows ? 1 + 0.1×min(6, bellowsHits) : 1))"},"8":{"id":8,"name":"入神时长","formula":"4 + 2×Rank(everwick) + 0.4×Rank(glass) + 0.8×Rank(redglass) 秒（充能满 10 触发）"},"9":{"id":9,"name":"Quota(round)","formula":"quotas[round-1]（round ≤ 21）；否则 Round(quotas[20] × 1.18^(round-21))"},"10":{"id":10,"name":"OfferPrice(item)","formula":""},"11":{"id":11,"name":"Rank(id) 注意","formula":"只要拥有（rank > 0）就返回 1 —— 遗物实际是「拥有/未拥有」两态，公式里的系数只生效一次"}}]],0,0,[],[],[]]
